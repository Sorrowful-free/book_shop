# gRPC server
GRPC_PORT=50051

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db

# Kafka brokers (comma-separated) — outbox relay publisher
KAFKA_BROKERS=localhost:29092

# Redis — JWT denylist `auth:revoked:{jti}` (auth-service is the only writer)
REDIS_URL=redis://localhost:6379

# Ed25519 keys as base64-encoded PEM (generate: bun run gen-keys).
# Each key may instead be read from a file via its <NAME>_FILE variant —
# the file wins when both are set (docker-secrets convention).
JWT_PRIVATE_KEY=
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem

# Token TTLs (seconds)
JWT_ACCESS_TTL_SEC=28800
JWT_REFRESH_TTL_SEC=2592000

# Refresh-token GC: rows whose expires_at is older than this audit
# retention are deleted (seconds, default 7 days)
REFRESH_TOKEN_AUDIT_TTL_SEC=604800
# Interval of the refresh-token sweeper (seconds, default 1 hour)
REFRESH_TOKEN_SWEEP_INTERVAL_SEC=3600

# Seed admin credentials (created at bootstrap; defaults: admin / admin)
SEED_ADMIN_USER_NAME=admin
SEED_ADMIN_PASSWORD=admin

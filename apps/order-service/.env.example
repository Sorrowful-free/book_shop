# gRPC server
GRPC_PORT=50054

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://order_user:order_pass@localhost:5432/order_db

# Kafka brokers (comma-separated) — outbox relay publisher
KAFKA_BROKERS=localhost:29092

# Ed25519 public key as base64-encoded PEM — JWT verification only
# (generate: bun run gen-keys inside apps/auth-service — the script lives there).
# JWT_PUBLIC_KEY_FILE may point at a key file instead — it wins when set.
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem

# Redis — JWT denylist `auth:revoked:{jti}` (read-only here)
REDIS_URL=redis://localhost:6379

# Outbound gRPC dependencies — the caller's `authorization` metadata is
# forwarded verbatim on every saga call
CART_GRPC_ADDR=localhost:50053
CATALOG_GRPC_ADDR=localhost:50052

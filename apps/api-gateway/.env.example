# HTTP server
PORT=3000

# Ed25519 public key as base64-encoded PEM — JWT verification
# (the same key auth-service signs with; generate: bun run gen-keys
# inside apps/auth-service — the script lives there).
# JWT_PUBLIC_KEY_FILE may point at a key file instead — it wins when set.
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem

# Redis — JWT denylist reads `auth:revoked:{jti}` only (read-only;
# auth-service is the only writer)
REDIS_URL=redis://localhost:6379

# Upstream gRPC services (cluster-internal plaintext)
AUTH_GRPC_ADDR=localhost:50051
CATALOG_GRPC_ADDR=localhost:50052
CART_GRPC_ADDR=localhost:50053
ORDER_GRPC_ADDR=localhost:50054

# Secure flag on cookies (true in prod behind TLS)
COOKIE_SECURE=false

# CORS origin for the web frontend (cookies → credentials are enabled)
CORS_ORIGIN=http://localhost:3001

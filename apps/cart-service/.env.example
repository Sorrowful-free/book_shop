# gRPC server
GRPC_PORT=50053

# Redis — cart documents `cart:user:{user_id}` / `cart:guest:{cart_id}`
# plus JWT denylist reads `auth:revoked:{jti}` (auth-service is the only writer)
REDIS_URL=redis://localhost:6379

# Sliding cart TTL in seconds, renewed on every successful cart-touching RPC
# (default: 7 days)
CART_TTL_SEC=604800

# Kafka brokers (comma-separated) — consumer only:
# `order.order.events` (order.order.created → ClearCart), group `cart-service`
KAFKA_BROKERS=localhost:29092

# Ed25519 public key as base64-encoded PEM — JWT verification
# (the same key auth-service signs with; generate: bun run infra/scripts/gen-keys.ts).
# JWT_PUBLIC_KEY_FILE may point at a key file instead — it wins when set.
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem

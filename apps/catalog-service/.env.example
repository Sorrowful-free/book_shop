# gRPC server
GRPC_PORT=50052

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://catalog_user:catalog_pass@localhost:5432/catalog_db

# Kafka brokers (comma-separated) — outbox relay publisher
KAFKA_BROKERS=localhost:29092

# Ed25519 public key as base64-encoded PEM — JWT verification only
# (generate: bun run gen-keys inside apps/auth-service — the script lives there).
# JWT_PUBLIC_KEY_FILE may point at a key file instead — it wins when set.
JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem

# Redis — JWT denylist `auth:revoked:{jti}` (read-only here)
REDIS_URL=redis://localhost:6379

# Temporary reservation TTL (seconds)
RESERVATION_TTL_SEC=900

# Interval of the expired-reservation sweeper (seconds)
RESERVATION_SWEEP_INTERVAL_SEC=60

# --- Book covers: S3-compatible object store (spec 08 §8) ---
# Internal endpoint used for object ops (getObject/statObject).
S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint used ONLY to sign presigned POST policies —
# the signature is computed over this host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=book-covers
S3_REGION=us-east-1
# MinIO dev credentials — <NAME>_FILE variants win when set (docker secrets).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
# S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key

# POST-policy upload cap (bytes) and presign TTL (seconds)
COVER_UPLOAD_MAX_BYTES=2097152
COVER_UPLOAD_TTL_SEC=600

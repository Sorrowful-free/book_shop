{
  "name": "@book-shop/catalog-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Book catalog: metadata, stock and temporary reservations (gRPC :50052)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "start": "bun run src/main.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@book-shop/common": "workspace:*",
    "@book-shop/contracts": "workspace:*",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.7.15",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/microservices": "^12.1.3",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.3",
    "prisma": "^6.0.0",
    "typescript": "^5.9.3"
  }
}

# Shared env for the `apps` compose profile — non-secret service wiring
# only (this file IS committed). Per-service values (DATABASE_URL, GRPC_PORT,
# SEED_*) live in each service's `environment:` block in
# infra/docker-compose.yml; the JWT keys arrive via docker secrets
# (`bun run infra:secrets` → infra/secrets/*.pem).

# Infra addressing — compose DNS names. kafka:9092 is the INTERNAL listener;
# localhost:29092 stays for apps running on the host.
KAFKA_BROKERS=kafka:9092
REDIS_URL=redis://redis:6379

# docker-secrets mount point — every JWT-verifying service reads the public
# key through the <NAME>_FILE convention (resolveSecret in @book-shop/common).
# auth-service additionally gets JWT_PRIVATE_KEY_FILE via its own
# `environment:` block.
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public

# Inter-service gRPC addresses (consumed by api-gateway and order-service;
# gRPC ports are never published to the host).
AUTH_GRPC_ADDR=auth-service:50051
CATALOG_GRPC_ADDR=catalog-service:50052
CART_GRPC_ADDR=cart-service:50053
ORDER_GRPC_ADDR=order-service:50054

# api-gateway HTTP surface: demo stack is plain HTTP so cookies aren't
# Secure; CORS_ORIGIN is the BROWSER origin and therefore stays localhost
# even though the gateway itself is reached at api-gateway:3000 internally.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3001

# Object storage for book covers (spec 08 §8): catalog-service is the sole
# accessor. S3_ENDPOINT/S3_PUBLIC_ENDPOINT are per-service in
# docker-compose.yml (internal vs browser-reachable); dev creds here match
# MINIO_ROOT_* — committed like postgres/postgres, never reused in prod.
S3_BUCKET=book-covers
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
COVER_UPLOAD_MAX_BYTES=2097152
COVER_UPLOAD_TTL_SEC=600

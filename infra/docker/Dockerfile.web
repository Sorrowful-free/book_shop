# apps/web production image (docs/specs/07-docker.md §3.2), two stages:
#   1. oven/bun — workspace install + `bunx --bun nuxt build` → .output/
#   2. node:22-alpine — serves the nitro node-server preset, proving the
#      Node.js portability rule (no Bun runtime APIs in app code).
#
# Build context MUST be the repo root:
#   docker build -f infra/docker/Dockerfile.web .
#
# Runtime env (set in infra/docker-compose.yml): NUXT_GATEWAY_URL overrides
# runtimeConfig.gatewayUrl in the built .output (nuxt.config.ts is NOT
# executed there — plain GATEWAY_URL does nothing), PORT/HOST steer nitro.

FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY tsconfig.json tsconfig.base.json ./
# All workspaces — same reasoning as Dockerfile.service: the frozen lockfile
# covers the whole repo and a partial tree breaks `bun install`.
COPY packages ./packages
COPY apps ./apps
RUN bun install --frozen-lockfile
WORKDIR /app/apps/web
RUN bunx --bun nuxt build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/web/.output ./.output
EXPOSE 3001
CMD ["node", ".output/server/index.mjs"]

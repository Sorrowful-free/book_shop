{
  "name": "@book-shop/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared service contracts: protobuf files, Kafka topics and event payloads",
  "exports": {
    ".": "./src/index.ts",
    "./covers": "./src/covers.ts",
    "./proto/*": "./proto/*",
    "./gen/*": "./src/gen/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "proto:gen": "buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "bun-types": "^1.3.3",
    "ts-proto": "^2.15.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/microservices": "^12.1.3",
    "protobufjs": "^8.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}

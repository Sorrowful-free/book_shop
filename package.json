{
  "name": "book_shop",
  "version": "0.0.1",
  "private": true,
  "description": "Book shop — microservices showcase (NestJS + gRPC + Kafka) with Nuxt SSR frontend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "test": "bun test",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md,yml}\"",
    "proto:lint": "buf lint packages/contracts",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "bun-types": "^1.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}

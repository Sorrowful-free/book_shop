{
  "name": "book_shop_backend",
  "version": "0.0.1",
  "description": "Book shop REST API backend built with NestJS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "bunx --bun nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_ENV_FILE=./env/debug.env bunx --bun nest start --exec bun",
    "start:dev": "NODE_ENV_FILE=./env/debug.env bunx --bun nest start --watch --exec bun",
    "start:debug": "NODE_ENV_FILE=./env/debug.env bun --inspect --watch src/main.ts",
    "start:prod": "NODE_ENV_FILE=./env/prod.env bun dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV_FILE=./env/debug.env bun test",
    "test:watch": "NODE_ENV_FILE=./env/debug.env bun test --watch",
    "test:cov": "NODE_ENV_FILE=./env/debug.env bun test --coverage",
    "test:e2e": "NODE_ENV_FILE=./env/debug.env bun test ./test"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "ioredis": "^5.11.1",
    "mongoose": "^8.24.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "bun-types": "^1.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}

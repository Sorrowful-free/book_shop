{
  "name": "book_shop",
  "version": "0.0.1",
  "private": true,
  "description": "Book shop — microservices showcase (NestJS + gRPC + Kafka) with Nuxt SSR frontend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "infra:secrets": "bash infra/scripts/gen-secrets.sh",
    "apps:up": "docker compose -f infra/docker-compose.yml --profile apps up -d --build",
    "apps:down": "docker compose -f infra/docker-compose.yml --profile apps down",
    "apps:logs": "docker compose -f infra/docker-compose.yml --profile apps logs -f",
    "test": "bun test",
    "test:unit": "bun test src apps/web",
    "test:e2e": "bun test e2e",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx,vue}\"",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md,yml}\"",
    "proto:lint": "buf lint packages/contracts",
    "proto:gen": "bun --filter '@book-shop/contracts' proto:gen",
    "db:generate": "bun --filter '@book-shop/auth-service' db:generate && bun --filter '@book-shop/catalog-service' db:generate && bun --filter '@book-shop/order-service' db:generate",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "bun-types": "^1.3.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "10.4.1"
  }
}
